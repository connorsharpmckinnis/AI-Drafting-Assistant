# AI Drafting Assistant
# Ignore local runtime, secrets, model weights, and operational data.
# Source, lockfile, and Python version pin stay tracked.

# --- Secrets and credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.kdbx
credentials.json
credentials*.json
secrets.json
secrets*.json
*service-account*.json
*serviceAccount*.json
.google/
gcloud/
token.json
client_secret*.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Test, type-check, and lint caches
