.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.cache/

# --- uv ---
# Keep uv.lock. Ignore the local package cache only.
.uv/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/
profile_default/
ipython_config.py

# --- Gradio local runtime ---
# Certificates, flagged datasets, and the component cache are machine-local.
.gradio/

# --- Model weights ---
# Do not publish trained or downloaded weights.
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.gguf
*.tflite
*.pb
*.h5
*.hdf5
*.joblib
*.pkl
*.pickle
