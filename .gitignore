model.safetensors
models/
checkpoints/
checkpoint-*/
weights/
wandb/
mlruns/
runs/

# --- Operational data ---
# Local inputs, generated outputs, and logs. Commit fixtures under a
# tracked path such as examples/ if a sample is meant to be public.
data/
datasets/
raw/
processed/
outputs/
output/
results/
logs/
*.log
uploads/
tmp/
temp/
*.tmp

